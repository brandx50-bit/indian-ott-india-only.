# Supply ONE credential privately in this file or the hosting secret settings.
# TMDB v3 API key:
TMDB_API_KEY=
# Or the API Read Access Token (preferred; Authorization: Bearer):
TMDB_READ_ACCESS_TOKEN=
HOST=0.0.0.0
PORT=7000
# Set to your real HTTPS service origin after deployment; no trailing path.
PUBLIC_BASE_URL=
# Nine required candidates; Netflix is opt-in, requires the same live checks.
PROVIDERS=jiohotstar,sonyliv,zee5,primevideo,sunnxt,hoichoi,erosnow,airtelxstream,lionsgateplay
# Number of verified items retained per row. Finite snapshot pagination, 100/page.
ROW_LIMIT=40
# 3 pages = up to 60 global weekly TMDB trending candidates per content type.
TRENDING_PAGES=3
# Scan up to 8 Discover pages to refill rows after invalid/rental offers are removed.
DISCOVER_SCAN_PAGES=8
NEW_RELEASE_DAYS=90
REFRESH_HOURS=12
STALE_HOURS=48
TMDB_CACHE_HOURS=6
REQUEST_INTERVAL_MS=250
REQUEST_TIMEOUT_MS=10000
CACHE_DIR=.cache

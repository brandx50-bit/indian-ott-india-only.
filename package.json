{
  "name": "personal-indian-ott-catalogs",
  "version": "1.0.0",
  "private": true,
  "description": "Catalog-only Indian OTT discovery for Stremio using TMDB and JustWatch availability",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "verify:live": "node --env-file-if-exists=.env scripts/verify-live.js",
    "refresh": "node --env-file-if-exists=.env scripts/refresh.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "stremio-addon-sdk": "1.6.10"
  },
  "overrides": {
    "stremio-addon-sdk": {
      "router": {
        "path-to-regexp": "0.1.13"
      }
    },
    "tmp": "0.2.7"
  }
}
